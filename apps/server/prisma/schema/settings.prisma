model Setting {
  id        String   @id @map("_id") @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("setting")
} 

/// TwentyFourSeven's own playlist login, used when ESPG is not connected.
model PlaylistLogin {
  id             String   @id @default(cuid()) @map("_id")
  userId         String   @unique
  username       String   @unique
  /// Sealed with the app secret so it can be shown again to its owner.
  passwordSealed String
  /// true once an admin typed this username/password; a reset or sync never overwrites it.
  custom         Boolean  @default(false)
  /// "legacy" = made before the ESPG-style rule (tfs<name><hex>), "default" = the ESPG rule, "custom" = typed by an admin.
  origin         String   @default("legacy")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@map("playlist_login")
}
