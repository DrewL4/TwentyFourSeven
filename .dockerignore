# Dependencies (root + workspace; avoids ~800MB context upload)
node_modules
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Production / build artifacts (built inside Docker)
**/.next
**/out
**/dist
.turbo

# Prisma: engines are generated in the builder (linux target)
apps/server/prisma/generated

# Local databases and runtime data
**/*.db
**/*.db-journal
**/*.sqlite
**/*.sqlite3
apps/server/database

# Environment variables
.env
.env.*
!.env.example
apps/**/.env
apps/**/.env.*
!apps/**/.env.example

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Docker (not needed in build context)
Dockerfile*
docker-compose*
.dockerignore

# Documentation
README.md
docs
*.md

# Testing
coverage
.nyc_output
**/*.test.ts
**/*.test.tsx

# Logs
logs
**/*.log

# Runtime / temp
pids
*.pid
*.seed
*.pid.lock
tmp
temp

# Tool caches
.cache
.parcel-cache
.eslintcache
.stylelintcache
**/.tsbuildinfo
